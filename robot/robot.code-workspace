{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// This workspace opens robot/ as its only folder, so the repository
		// root .vscode/settings.json is not loaded. The RobotCode settings from
		// there are repeated here, rebased onto this folder.

		// Not "robotcode.python": that setting is deprecated and is passed to
		// spawn() verbatim, so ${workspaceFolder} is never expanded and the
		// interpreter fails to launch. python.defaultInterpreterPath does
		// resolve the variable, and RobotCode reads the interpreter from the
		// Python extension when robotcode.python is unset.
		//
		// The interpreter path differs per platform; swap these two lines on
		// POSIX. "Python: Select Interpreter" overrides whichever is active.
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
		// "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"robotcode.robot.paths": ["tests"],
		"robotcode.robot.outputDir": "results",
		"robotcode.robocop.enabled": true,
		"robotcode.robocop.configFile": "pyproject.toml",
		"robotcode.analysis.diagnosticMode": "workspace",
		"robotcode.editor.4SpacesTab": true,
		"[robotframework]": {
			"editor.defaultFormatter": "d-biehl.robotcode",
			"editor.formatOnSave": true,
			"editor.rulers": [100],
			"editor.tabSize": 4,
			"editor.insertSpaces": true
		},
		"search.exclude": {
			"**/.venv": true,
			"results": true
		},
		"files.watcherExclude": {
			"**/.venv/**": true,
			"results/**": true
		}
	}
}
