{
  // Editor behavior
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ---------------------------------------------------------------- Rust ---
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },

  // The Cargo workspace lives in rust/, not at the repository root, so
  // rust-analyzer needs to be pointed at its manifest explicitly.
  "rust-analyzer.linkedProjects": ["./rust/Cargo.toml"],

  // Run clippy instead of `cargo check` so lints show up as you type.
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--all-targets"],
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.checkOnSave": true,

  // Inlay hints: types and parameter names inline. Toggle with the
  // "Editor > Inlay Hints: Enabled" setting if they get noisy.
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "with_block",

  // Import style: prefer `use foo::bar;` over inline paths, group std/extern/self.
  "rust-analyzer.imports.granularity.group": "module",
  "rust-analyzer.imports.prefix": "crate",

  // -------------------------------------------------------------- Python ---
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // src/ layout: tell the language server where the importable package lives
  // so `from app.main import ...` resolves in the editor.
  "python.analysis.extraPaths": ["./python/src"],
  "python.analysis.typeCheckingMode": "standard",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["python/tests"],

  // ---------------------------------------------------------- C# / WPF ---
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[xml]": {
    "editor.formatOnSave": false
  },

  // The solution is not at the workspace root, so name it explicitly
  // instead of letting the C# extension prompt on every start.
  "dotnet.defaultSolution": "csharp/WpfApp.sln",
  "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "omnisharp.enableEditorConfigSupport": true,

  // ----------------------------------------------- Robot Framework ---
  "[robotframework]": {
    "editor.defaultFormatter": "d-biehl.robotcode",
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // Robot separates cells by two or more spaces, so a tab must not collapse
  // to fewer than the four spaces the formatter emits.
  "robotcode.editor.4SpacesTab": true,

  // RobotCode needs the interpreter that has robotframework, Browser and
  // RequestsLibrary installed - that is robot/.venv. It takes that from the
  // Python extension, so point the Python extension at it: uncomment the line
  // for your platform, or run "Python: Select Interpreter".
  //
  // Do not use "robotcode.python" for this. It is deprecated, and RobotCode
  // hands its value straight to spawn() without expanding ${workspaceFolder},
  // so a path written that way fails to launch and the extension reports
  // "Invalid python version for workspace folder". python.defaultInterpreterPath
  // is resolved by the Python extension and does expand the variable.
  //
  // Note this is window-wide: a single-folder window has one active interpreter,
  // so it applies to the python/ subspace too. Per-folder interpreters need a
  // multi-root .code-workspace - robot/robot.code-workspace already carries the
  // robot/ half of this configuration for that reason.
  // "python.defaultInterpreterPath": "${workspaceFolder}/robot/.venv/bin/python",
  // "python.defaultInterpreterPath": "${workspaceFolder}/robot/.venv/Scripts/python.exe",

  // Where the Test Explorer looks for suites, and where a run from the editor
  // writes log.html/report.html - same layout as the command line.
  "robotcode.robot.paths": ["robot/tests"],
  "robotcode.robot.outputDir": "robot/results",

  // Lint with the same Robocop configuration the command line uses.
  "robotcode.robocop.enabled": true,
  "robotcode.robocop.configFile": "robot/pyproject.toml",
  "robotcode.analysis.diagnosticMode": "workspace",

  // ------------------------------------------------------------ Explorer ---
  "files.exclude": {
    "**/target": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/bin": true,
    "**/obj": true
  },
  "search.exclude": {
    "**/target": true,
    "**/Cargo.lock": true,
    "**/.venv": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/bin": true,
    "**/obj": true,
    "robot/results": true
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.venv/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "robot/results/**": true
  }
}
